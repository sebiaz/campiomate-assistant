{
  "baseUrl": "https://campiomate.ro",
  "browser": {
    "headless": false,
    "slowMo": 100,
    "viewport": { "width": 1280, "height": 720 }
  },
  "selectors": {
    "trainingPage": {
      "table": "table, .training-table, .exercises-table, table[class*='training'], table[class*='exercise']",
      "rows": "tr[data-worksheet], tr[class*='training'], tr[class*='exercise'], tbody tr",
      "worksheetId": "data-worksheet, data-id, data-exercise-id",
      "topic": "td:first-child, .topic, .title, [class*='topic'], [class*='title']",
      "grade": "td:nth-child(2), .grade, [class*='grade']",
      "level": "td:nth-child(3), .level, .division, [class*='level'], [class*='division']",
      "round": "td:nth-child(4), .round, [class*='round']"
    },
    "exercisePage": {
      "questionContainer": "[data-exercise], .exercise-content, .question-container, .problem-statement, .enunt, .exercise-body, main, .content",
      "questionText": ".question-text, .exercise-question, [data-question], .enunt, .problem-text, .statement, h1, h2, h3, .question, p",
      "answerInput": "input[type='text'], input[type='number'], textarea, .answer-input, [name*='answer'], [id*='answer'], input:not([type='hidden']):not([type='submit']):not([type='button'])",
      "multipleChoice": "input[type='radio'], .choice-option, [class*='choice'], [class*='option'], label[for*='radio']",
      "checkboxes": "input[type='checkbox'], [class*='checkbox']",
      "submitButton": "button[type='submit'], .btn-submit, button:has-text('Salvează'), button:has-text('Trimite'), button:has-text('Submit'), button:has-text('Răspunde'), button:has-text('Verifică'), input[type='submit'], button[class*='submit'], button[class*='save']",
      "nextButton": "button:has-text('Următorul'), button:has-text('Next'), .btn-next, button:has-text('Continuă'), a:has-text('Următorul')",
      "confidenceIndicator": ".confidence, .answer-confidence"
    },
    "navigation": {
      "backLink": "a:has-text('Înapoi'), a:has-text('Back'), a[href*='training']",
      "trainingLink": "a:has-text('Pregătire'), a:has-text('Training'), a[href*='training']"
    }
  },
  "answerTypes": {
    "boolean": { "icon": "icon-answer-boolean", "handler": "boolean" },
    "decimal": { "icon": "icon-answer-decimal", "handler": "numeric" },
    "fraction": { "icon": "icon-answer-fraction", "handler": "fraction" },
    "integer": { "icon": "icon-answer-integer", "handler": "numeric" },
    "natural": { "icon": "icon-answer-natural", "handler": "numeric" },
    "numberFraction": { "icon": "icon-answer-number-fraction", "handler": "fraction" },
    "periodic": { "icon": "icon-answer-periodic", "handler": "text" },
    "text": { "icon": "icon-answer-text", "handler": "text" }
  },
  "ai": {
    "enabled": false,
    "provider": "local",
    "model": "gpt-4o-mini",
    "apiKeyEnv": "OPENAI_API_KEY",
    "maxTokens": 500,
    "temperature": 0.1
  },
  "logging": {
    "level": "info",
    "file": "logs/campiomate-assistant.log"
  },
  "autoSubmit": false,
  "dryRun": false,
  "timeout": 30000,
  "retryAttempts": 3
}